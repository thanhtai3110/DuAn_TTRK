# Configure these in Render's environment settings; never use VITE_ prefixes.
# For local use, export these variables in the terminal before npm run dev.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-token
# Enable on free cloud hosting to reject accidental ephemeral SQLite storage.
REQUIRE_REMOTE_DB=true
